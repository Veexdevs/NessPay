# .env.example — tudo que o painel + bot precisam.
# Copie para .env e preencha. NUNCA comite o .env.

# ---------- Front-end (Vite) ----------
# Client ID da aplicação Discord. Opcional: se vazio, o painel usa o
# Client ID padrão embutido no código (1561323387320668193).
# No Vercel: Settings → Environment Variables → adicione e faça REDEPLOY
# (variáveis VITE_* são gravadas no build, não em runtime).
VITE_DISCORD_CLIENT_ID=

# Opcional: sobrescreve o redirect do login.
# Padrão: {origem do site}/auth/callback
# Use apenas se você cadastrou outro caminho no Developer Portal.
VITE_DISCORD_REDIRECT_URI=

# URL do backend do bot. Sem ela, vendas/clientes/tickets ficam vazios.
VITE_API_URL=

# ---------- Discord ----------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LOG_WEBHOOK=

# ---------- Licença (Key) ----------
LICENSE_API_URL=
LICENSE_SECRET=

# ---------- Pagamento ----------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Banco ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Infra ----------
PUBLIC_WEBHOOK_URL=
JWT_SECRET=
