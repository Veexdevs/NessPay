# .env.example — tudo que o painel + bot precisam.
# Copie para .env e preencha. NUNCA comite o .env.

# ---------- Front-end (Vite) ----------
# Client ID da aplicação Discord — sem ele o login real não funciona
# (o painel entra em "modo configuração" e não inventa servidores).
VITE_DISCORD_CLIENT_ID=

# URL do backend do bot. Sem ela, vendas/clientes/tickets ficam vazios.
VITE_API_URL=

# ---------- Discord ----------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LOG_WEBHOOK=

# ---------- Licença (Key) ----------
LICENSE_API_URL=
LICENSE_SECRET=

# ---------- Pagamento ----------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Banco ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Infra ----------
PUBLIC_WEBHOOK_URL=
JWT_SECRET=
