# Variaveis do painel (Vercel)
# Copie para .env e preencha. Nunca comite o .env.

# Client ID da aplicacao Discord. Se vazio, o painel usa 1561323387320668193.
VITE_DISCORD_CLIENT_ID=

# Opcional: sobrescreve o redirect do login. Padrao: {origem}/auth/callback
VITE_DISCORD_REDIRECT_URI=

# URL publica da API do bot (ex: https://api.seudominio.com).
# Em desenvolvimento, se vazio, o painel usa /api com proxy para 127.0.0.1:8000.
VITE_API_URL=

# Mesmo valor de API_KEY no .env do bot. Sem isso a API responde 401.
VITE_API_KEY=

# As variaveis do bot ficam em bot/.env (veja bot/.env.example)
